PORT=3000
SECRET=mets-une-longue-phrase-aleatoire-ici
# Emails reels (obligatoire en production). Exemple Gmail: smtp.gmail.com / 587 / mot de passe d'application
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=ton-compte@example.com
SMTP_PASS=mot-de-passe-application
MAIL_FROM=VOGT ELECTIONS <ton-compte@example.com>
# Restreindre aux emails etudiants (laisser vide = tous)
ALLOWED_DOMAIN=
ELIGIBLE_VOTERS=1000
MAX_CHANGES=3
# Cles d'acces (plusieurs cles BDE separees par des virgules)
BDE_KEYS=cle-bde-1,cle-bde-2
GHOST_KEY=cle-ghost-longue-et-secrete
# Derriere HTTPS / proxy (Render, Railway, Nginx...)
COOKIE_SECURE=0
TRUST_PROXY=0
# Options
ADMIN_SHOW_BREAKDOWN=0
SHOW_PUBLIC_COUNTS=0
