PORT=3000
# Chaine aleatoire longue. Ne JAMAIS la changer apres le premier vote.
SECRET=mets-une-longue-phrase-aleatoire-ici
# Base Turso (laisser vide en test local : un fichier vogt.db est utilise)
TURSO_DATABASE_URL=libsql://ta-base-ton-compte.turso.io
TURSO_AUTH_TOKEN=
# Emails sur Render gratuit : cle API Brevo (le SMTP y est bloque)
BREVO_API_KEY=
# Emails reels (SMTP, hors Render gratuit) (obligatoire en production)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VOGT ELECTIONS <ton-adresse-verifiee@example.com>
# Restreindre aux emails de l'ecole (vide = tous)
ALLOWED_DOMAIN=
ELIGIBLE_VOTERS=1000
MAX_CHANGES=3
BDE_KEYS=cle-bde-1,cle-bde-2
GHOST_KEY=cle-ghost-longue-et-secrete
# En ligne (HTTPS)
COOKIE_SECURE=0
TRUST_PROXY=0
ADMIN_SHOW_BREAKDOWN=0
SHOW_PUBLIC_COUNTS=0
# 1 = crée une élection de démonstration (tests locaux seulement)
SEED_DEMO=1
